# --- Database (REQUIRED) ---------------------------------------------------
# PostgreSQL. Cached market data is stored here so the site still has results
# after a restart instead of re-scanning ~160 sets from scratch.
#
# Free option: https://neon.tech - free forever, no card, 0.5 GB, no expiry.
# (Render's own free Postgres is DELETED after 30 days - don't use it for this.)
DATABASE_URL="postgresql://wf:wf@127.0.0.1:5432/wfarb"

# How long cached results stay usable after a restart, in hours. Default 144 (6 days).
# Entries older than this are ignored and re-scanned rather than shown as current.
CACHE_MAX_AGE_HOURS="144"

# --- Warframe.market public API -------------------------------------------
WFM_API_BASE="https://api.warframe.market/v2"
WFM_PLATFORM="pc"
WFM_CROSSPLAY="true"
WFM_LANGUAGE="en"
WFM_RATE_LIMIT_RPS="3"

# --- Scanner --------------------------------------------------------------
REFRESH_INTERVAL_SECONDS="120"
SCANNER_WARMUP_LIMIT="12"      # sets scanned on the first pass after a (re)start
SCANNER_BATCH_LIMIT="20"       # sets scanned per background cycle once warm
SCANNER_MAX_RESULTS="400"      # cap in-memory analyses (memory safety)
SCANNER_BOOT_DELAY_MS="2500"   # delay first scan so the port binds immediately
# DISABLE_BACKGROUND_SCAN="true"

# --- Build / runtime ------------------------------------------------------
# NEXT_DIST_DIR=".next"        # set a unique value when running a 2nd instance
