# ---------------------------------------------------------------------------
# Database (REQUIRED for accounts/PRO/quota; optional for the bare scanner)
# ---------------------------------------------------------------------------
# PostgreSQL. The scanner cache AND the account/subscription/quota tables live
# here. Free option: https://neon.tech (Render's own free Postgres is deleted
# after 30 days - don't use it). Without DATABASE_URL the scanner still works,
# but signup/login/PRO cannot function and anonymous quota falls back to an
# in-memory counter (resets on restart).
DATABASE_URL="postgresql://wf:wf@127.0.0.1:5432/wfarb"

# How long cached results stay usable after a restart, in hours. Default 144 (6 days).
CACHE_MAX_AGE_HOURS="144"

# --- Auth / accounts (server-only secrets — never expose to the browser) ----
# Stable secret for signing guest cookies, hashing session tokens context and
# anonymizing IP quota scopes. Generate with:  openssl rand -base64 32
# REQUIRED in production: if unset, a random per-boot value is used and all
# sessions + anonymous quota identities reset on every restart.
AUTH_SECRET=""

# --- Search quota -----------------------------------------------------------
# FREE plan daily set-search limit (default 5). PRO is always unlimited.
FREE_SEARCH_LIMIT="5"
# Calendar day boundary timezone for the daily quota reset (IANA name).
QUOTA_TIMEZONE="UTC"

# --- Email (verification + password reset) ----------------------------------
# Any SMTP URL: Gmail app password (smtp://user:app-password@smtp.gmail.com:465),
# Resend (smtp://resend:re_xxxx@smtp.resend.com:465), SendGrid, Mailgun, etc.
# OPTIONAL: without it, accounts start pre-verified and password reset is
# disabled with an honest error (reset links are logged server-side in dev).
SMTP_URL=""
MAIL_FROM="Warframe Prime Arbitrage <no-reply@yourdomain.example>"

# --- Stripe subscriptions ($6.99/month PRO) — SERVER-ONLY SECRETS -----------
# 1) Create a product with a $6.99/month recurring price (test mode first).
# 2) Copy the price id here.
STRIPE_PRICE_ID=""
# 3) Secret key (sk_test_... for test mode, sk_live_... for production).
STRIPE_SECRET_KEY=""
# 4) Webhook endpoint signing secret: Stripe Dashboard → Developers → Webhooks
#    → Add endpoint → https://YOUR-DOMAIN/api/stripe/webhook with events:
#    checkout.session.completed, customer.subscription.created,
#    customer.subscription.updated, customer.subscription.deleted,
#    invoice.payment_failed  → copy the "whsec_..." secret here.
STRIPE_WEBHOOK_SECRET=""
# Absolute base URL of the deployment (used for checkout success/cancel URLs
# and email links). Leave empty to derive from incoming request headers.
APP_URL=""

# --- PRO feature gating (optional overrides) --------------------------------
# Any feature can be flipped: FEATURES_capital_calculator=free|pro
# Default: capital_calculator=pro, everything existing stays free.
# FEATURES_capital_calculator="pro"

# --- Capital Calculator tuning ----------------------------------------------
# CAPITAL_MAX_FETCHES="60"        # upstream order-book fetch budget per call
# CAPITAL_CANDIDATE_SETS="24"     # top-N scanner sets evaluated

# --- Warframe.market public API ---------------------------------------------
WFM_API_BASE="https://api.warframe.market/v2"
WFM_PLATFORM="pc"
WFM_CROSSPLAY="true"
WFM_LANGUAGE="en"
WFM_RATE_LIMIT_RPS="3"

# --- Scanner ----------------------------------------------------------------
REFRESH_INTERVAL_SECONDS="120"
SCANNER_WARMUP_LIMIT="12"      # sets scanned on the first pass after a (re)start
SCANNER_BATCH_LIMIT="20"       # sets scanned per background cycle once warm
SCANNER_MAX_RESULTS="400"      # cap in-memory analyses (memory safety)
SCANNER_BOOT_DELAY_MS="2500"   # delay first scan so the port binds immediately
# DISABLE_BACKGROUND_SCAN="true"

# --- Build / runtime --------------------------------------------------------
# NEXT_DIST_DIR=".next"        # set a unique value when running a 2nd instance
