{
  "name": "warframe-prime-arbitrage-scanner",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "test": "vitest run",
    "db:push": "DATABASE_URL=\"${DATABASE_URL:-postgresql://wf:wf@127.0.0.1:5432/wfarb}\" prisma db push",
    "start:render": "sh ./scripts/start-render.sh",
    "db:setup": "DATABASE_URL=\"${DATABASE_URL:-postgresql://wf:wf@127.0.0.1:5432/wfarb}\" prisma db push --skip-generate --accept-data-loss",
    "predev": "node scripts/setup-env.mjs",
    "setup": "node scripts/setup-env.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "14.2.15",
    "nodemailer": "^10.0.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "stripe": "^22.6.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
